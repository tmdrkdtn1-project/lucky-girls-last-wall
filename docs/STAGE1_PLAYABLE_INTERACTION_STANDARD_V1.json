{
  "schema": "LG_STAGE1_PLAYABLE_INTERACTION_STANDARD_V1",
  "project": "Lucky Girls: Last Wall",
  "build_target": "STAGE1_PLAYABLE_APK_V0.1",
  "status": "IMPLEMENTATION_BASELINE",
  "display": {
    "orientation": "landscape",
    "top_ui": "fixed",
    "bottom_ui": "contextual_hidden_by_default"
  },
  "map": {
    "cols": 18,
    "rows": 10,
    "total_cells": 180,
    "default_field_barricade_B": false,
    "castle_pattern": [
      "CC",
      "GO",
      "CC"
    ]
  },
  "interaction_rules": {
    "empty_deploy_tile": {
      "tap": "SHOW_BOTTOM_UI",
      "content": "PLACEABLE_BASIC_UNITS"
    },
    "occupied_allied_unit": {
      "tap": "SHOW_BOTTOM_UI",
      "content": [
        "UPGRADE",
        "REPLACE_HIGHER_UNIT",
        "SELL_IF_ALLOWED"
      ]
    },
    "hero_combo_ready": {
      "highlight_material_units": true,
      "tap_any_material": "SHOW_BOTTOM_UI",
      "content": "AVAILABLE_HERO_COMBO"
    },
    "no_selection": {
      "bottom_ui_visible": false
    }
  },
  "ui": {
    "top_fixed": [
      "WAVE",
      "GOLD",
      "G_HP",
      "O_HP",
      "SPEED",
      "PAUSE"
    ],
    "bottom_contextual": {
      "hidden_without_selection": true,
      "modes": [
        "PLACE",
        "UNIT_ACTION",
        "HERO_COMBO"
      ]
    }
  }
}
